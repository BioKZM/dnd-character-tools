{
  "id": "hobgoblin",
  "name": "Hobgoblin",
  "category": "monstrous",
  "summary": "Disciplined, militaristic goblinoids. Hobgoblins value order, rank and honor, and they fight best when their allies are close by.",
  "source": {
    "book": "Volo's Guide to Monsters"
  },
  "facts": {
    "age": {
      "summary": "Hobgoblins mature like humans and live about as long."
    },
    "alignment": {
      "summary": "Hobgoblins are mostly lawful evil."
    },
    "size": {
      "category": "Medium",
      "description": "Hobgoblins are about the size of humans."
    },
    "speed": {
      "walk": 30,
      "description": "Your base walking speed is 30 feet."
    },
    "languages": {
      "values": [
        "Common",
        "Goblin"
      ],
      "description": "You can speak, read, and write Common and Goblin."
    },
    "abilityScoreBonuses": [
      {
        "type": "fixed",
        "ability": "CON",
        "amount": 2
      },
      {
        "type": "fixed",
        "ability": "INT",
        "amount": 1
      }
    ]
  },
  "features": [
    {
      "id": "darkvision",
      "name": "Darkvision",
      "category": "sense",
      "summary": "You see in dim light within 60 feet as if it were bright light, and in darkness as if it were dim light (shades of gray only).",
      "grants": [
        {
          "type": "sense",
          "sense": "darkvision",
          "value": 60
        }
      ],
      "choiceGroupIds": []
    },
    {
