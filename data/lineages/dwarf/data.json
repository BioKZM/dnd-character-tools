{
  "id": "dwarf",
  "name": "Dwarf",
  "category": "standard",
  "summary": "Stout, stubborn folk of mountain halls and deep mines. Dwarves are tough, hold long grudges and take pride in good stonework, metalwork and keeping their word.",
  "source": {
    "book": "Player's Handbook"
  },
  "facts": {
    "age": {
      "summary": "Dwarves come of age around 50 and can live about 350 years."
    },
    "alignment": {
      "summary": "Most dwarves lean lawful and good, valuing order and fairness."
    },
    "size": {
      "category": "Medium",
      "description": "Dwarves stand about 4 to 5 feet tall and are broad and heavy."
    },
    "speed": {
      "walk": 25,
      "description": "Your base walking speed is 25 feet. Heavy armor doesn't slow you down."
    },
    "languages": {
      "values": [
        "Common",
        "Dwarvish"
      ],
      "description": "You can speak, read, and write Common and Dwarvish."
    },
