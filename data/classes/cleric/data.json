  "highlights": [
    {
      "title": "Combat Role",
      "body": "The classic healer and support caster, with armor and a domain that can make you a front-liner, a blaster or a trickster."
    },
    {
      "title": "Core Resources",
      "body": "Prepare spells each day from the whole cleric list (level + WIS). Channel Divinity recharges on a short rest."
    },
    {
      "title": "Level Rhythm",
      "body": "Domain at 1, Channel Divinity at 2, 3rd-level spells at 5, Divine Intervention at 10, 9th-level spells at 17."
    }
