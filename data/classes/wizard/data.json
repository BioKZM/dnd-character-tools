  "spellcastingNotes": [
    "You prepare wizard spells from your spellbook after each long rest: your wizard level + your Intelligence modifier, minimum one."
  ],
  "classFeatures": [
    {
      "id": "spellcasting",
      "name": "Spellcasting",
      "keyFacts": [
        "You keep a spellbook. Prepare wizard spells from it after each long rest: your wizard level + INT modifier, at least one. Here you pick the spells you prepare; copy new spells into your book in play.",
        "Spell save DC = 8 + PB + INT; spell attack = PB + INT."
      ],
      "summary": "You can cast wizard spells. You keep a spellbook. Prepare wizard spells from it after each long rest: your wizard level + INT modifier, at least one. Here you pick the spells you prepare; copy new spells into your book in play. INT is your spellcasting ability: spell save DC = 8 + proficiency bonus + INT modifier, spell attack = proficiency bonus + INT modifier. You can use an arcane focus as a spellcasting focus. You regain all spell slots on a long rest.",
      "unlockLevel": 1,
      "short": "Cast wizard spells using INT.",
      "facts": {
        "action": "Special",
        "dc": "spell"
      }
    },
    {
      "id": "arcane-recovery",
      "name": "Arcane Recovery",
      "keyFacts": [
        "Slot levels up to half your wizard level (round up).",
        "No 6th-level or higher slots."
      ],
      "summary": "Once per day when you finish a short rest, you can recover expended spell slots with a combined level equal to or less than half your wizard level (rounded up). None of the slots can be 6th level or higher.",
      "unlockLevel": 1,
      "short": "Short rest: recover some spell slots once per day.",
      "facts": {
        "action": "Special",
        "uses": "1 per day"
      },
      "grants": [
        {
          "type": "resource",
          "id": "arcane-recovery",
          "name": "Arcane Recovery",
          "uses": 1,
          "recharge": "long_rest"
        }
      ]
    },
    {
      "id": "arcane-tradition",
      "name": "Arcane Tradition",
      "keyFacts": [
        "Subclass features at 2, 6, 10 and 14."
      ],
      "summary": "Choose an arcane tradition (school or order of magic). It grants features at 2nd, 6th, 10th and 14th level.",
      "unlockLevel": 2,
      "short": "Choose your school of magic.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "keyFacts": [
        "+2 to one ability or +1 to two, or a feat."
      ],
      "milestones": [
        {
          "level": 4,
          "label": "ASI"
        },
        {
          "level": 8,
          "label": "ASI"
        },
        {
          "level": 12,
          "label": "ASI"
        },
        {
          "level": 16,
          "label": "ASI"
        },
        {
          "level": 19,
          "label": "ASI"
        }
      ],
      "summary": "When you reach 4th level, and again at 8th, 12th, 16th, 19th level, you can increase one ability score by 2, or two ability scores by 1. You can't raise a score above 20 this way. If your DM allows feats, you can take a feat instead.",
      "unlockLevel": 4,
      "short": "Raise one ability by 2, two by 1, or take a feat.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "spell-mastery",
      "name": "Spell Mastery",
      "keyFacts": [
        "One 1st-level and one 2nd-level spell at will."
      ],
      "summary": "Choose a 1st-level and a 2nd-level wizard spell in your spellbook. You can cast them at their lowest level without expending a slot when you have them prepared.",
      "unlockLevel": 18,
      "short": "Cast one 1st- and one 2nd-level spell at will.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "signature-spells",
      "name": "Signature Spells",
      "keyFacts": [
        "Two 3rd-level spells, each free once per short rest."
      ],
      "summary": "Choose two 3rd-level wizard spells as signature spells. They are always prepared, don't count against your prepared spells, and you can cast each once at 3rd level without a slot per short or long rest.",
      "unlockLevel": 20,
      "short": "Two 3rd-level spells always ready and free once per rest.",
      "facts": {
        "action": "Passive"
      }
    }
  ],
