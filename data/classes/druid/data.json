  "spellcastingNotes": [
    "You prepare druid spells after each long rest: your druid level + your Wisdom modifier, minimum one."
  ],
  "classFeatures": [
    {
      "id": "druidic",
      "name": "Druidic",
      "keyFacts": [
        "Druidic language and hidden messages."
      ],
      "summary": "You know Druidic, the secret language of druids. You can speak it and use it to leave hidden messages that other druids notice.",
      "unlockLevel": 1,
      "short": "You speak the secret druid language.",
      "facts": {
        "action": "Passive"
      },
      "grants": [
        {
          "type": "proficiency",
          "category": "language",
          "values": [
            "Druidic"
          ]
        }
      ]
    },
    {
      "id": "spellcasting",
      "name": "Spellcasting",
      "keyFacts": [
        "Prepare druid spells after each long rest: your druid level + WIS modifier, at least one. You can cast prepared ritual spells as rituals.",
        "Spell save DC = 8 + PB + WIS; spell attack = PB + WIS."
      ],
      "summary": "You can cast druid spells. Prepare druid spells after each long rest: your druid level + WIS modifier, at least one. You can cast prepared ritual spells as rituals. WIS is your spellcasting ability: spell save DC = 8 + proficiency bonus + WIS modifier, spell attack = proficiency bonus + WIS modifier. You can use a druidic focus as a spellcasting focus. You regain all spell slots on a long rest.",
      "unlockLevel": 1,
      "short": "Cast druid spells using WIS.",
      "facts": {
        "action": "Special",
        "dc": "spell"
      }
    },
    {
      "id": "wild-shape",
      "name": "Wild Shape",
      "keyFacts": [
        "2 uses per short rest.",
        "Max beast CR grows with level."
      ],
      "summary": "As an action, you magically assume the shape of a beast you have seen before. You can use this twice per short or long rest and stay transformed for half your druid level in hours. The beast's challenge rating is limited by your level (no flying or swimming speed at first). You keep your mind and gain the beast's hit points; when they drop to 0 you revert.",
      "unlockLevel": 2,
      "short": "Action: turn into a beast you have seen.",
      "facts": {
        "action": "Action",
        "uses": "2 per short rest"
      },
      "grants": [
        {
          "type": "resource",
          "id": "wild-shape",
          "name": "Wild Shape",
          "uses": 2,
          "recharge": "short_rest"
        }
      ],
      "milestones": [
        {
          "level": 2,
          "label": "CR 1/4, no fly/swim"
        },
        {
          "level": 4,
          "label": "CR 1/2, no fly"
        },
        {
          "level": 8,
          "label": "CR 1"
        }
      ]
    },
    {
      "id": "druid-circle",
      "name": "Druid Circle",
      "keyFacts": [
        "Subclass features at 2, 6, 10 and 14."
      ],
      "summary": "Choose a circle of druids to identify with. It grants features at 2nd, 6th, 10th and 14th level.",
      "unlockLevel": 2,
      "short": "Choose your druid circle.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "keyFacts": [
        "+2 to one ability or +1 to two, or a feat."
      ],
      "milestones": [
        {
          "level": 4,
          "label": "ASI"
        },
        {
          "level": 8,
          "label": "ASI"
        },
        {
          "level": 12,
          "label": "ASI"
        },
        {
          "level": 16,
          "label": "ASI"
        },
        {
          "level": 19,
          "label": "ASI"
        }
      ],
      "summary": "When you reach 4th level, and again at 8th, 12th, 16th, 19th level, you can increase one ability score by 2, or two ability scores by 1. You can't raise a score above 20 this way. If your DM allows feats, you can take a feat instead.",
      "unlockLevel": 4,
      "short": "Raise one ability by 2, two by 1, or take a feat.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "timeless-body",
      "name": "Timeless Body",
      "keyFacts": [
        "Age 1 year per 10."
      ],
      "summary": "The primal magic you wield causes you to age more slowly: for every 10 years that pass, your body ages only 1 year.",
      "unlockLevel": 18,
      "short": "You age ten times slower.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "beast-spells",
      "name": "Beast Spells",
      "keyFacts": [
        "Cast druid spells in beast form (no costly material components)."
      ],
      "summary": "You can cast many of your druid spells in any shape you assume using Wild Shape, performing somatic and verbal components in beast form.",
      "unlockLevel": 18,
      "short": "Cast spells while in Wild Shape.",
      "facts": {
        "action": "Passive"
      }
    },
    {
      "id": "archdruid",
      "name": "Archdruid",
      "keyFacts": [
        "Unlimited Wild Shape uses.",
        "Ignore most spell components."
      ],
      "summary": "You can use Wild Shape an unlimited number of times, and you can ignore verbal, somatic and non-costly material components of druid spells.",
      "unlockLevel": 20,
      "short": "Unlimited Wild Shape.",
      "facts": {
        "action": "Passive"
      }
    }
  ],
