      "id": "mage-hand-legerdemain",
      "name": "Mage Hand Legerdemain",
      "unlockLevel": 3,
      "short": "Your invisible Mage Hand can pick pockets and locks.",
      "summary": "You learn Mage Hand, and you can make the hand invisible. You can use it to stow or retrieve objects in someone's container, use thieves' tools at range, and control it with Cunning Action's bonus action.",
      "facts": {
        "action": "Passive"
      },
      "grants": [
        {
          "type": "spell",
          "spellId": "mage-hand",
          "uses": "at_will"
