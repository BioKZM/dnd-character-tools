      "id": "magical-ambush",
      "name": "Magical Ambush",
      "unlockLevel": 9,
      "short": "Spells cast while hidden impose disadvantage on saves.",
      "summary": "If you are hidden from a creature when you cast a spell on it, it has disadvantage on any saving throw against the spell this turn.",
      "facts": {
        "action": "Passive"
      },
      "grants": [],
      "choices": []
    },
    {
      "id": "versatile-trickster",
      "name": "Versatile Trickster",
      "unlockLevel": 13,
      "short": "Bonus action: your Mage Hand gives you advantage.",
      "summary": "As a bonus action, you can designate a creature within 5 ft. of your spectral hand; you have advantage on attack rolls against it until the end of the turn.",
      "facts": {
        "action": "Bonus Action"
      },
      "grants": [],
      "choices": []
    },
    {
      "id": "spell-thief",
      "name": "Spell Thief",
      "unlockLevel": 17,
      "short": "Reaction: steal knowledge of a spell cast at you.",
      "summary": "When a creature casts a spell targeting you or including you in its area, you can use your reaction to force an INT/WIS/CHA save (its spellcasting ability). On a failure, you negate the spell's effect on you and steal its knowledge for 8 hours if it's of a level you can cast. Once per long rest.",
      "facts": {
        "action": "Reaction"
      },
