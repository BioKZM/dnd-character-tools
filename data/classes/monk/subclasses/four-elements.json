    {
      "id": "disciple-of-the-elements",
      "name": "Disciple of the Elements",
      "unlockLevel": 3,
      "short": "Learn elemental disciplines that spend ki on spell-like effects.",
      "summary": "You know Elemental Attunement (minor elemental tricks) and one other discipline. You learn another at 6th, 11th and 17th level. Spell disciplines use your ki save DC; you can spend extra ki to raise the spell's level, up to a cap based on your level.",
      "facts": {
        "action": "Passive"
      },
      "grants": [
        {
          "type": "note",
          "text": "Elemental Attunement: minor elemental effects at will (light a candle, chill a drink...)."
        }
      ],
